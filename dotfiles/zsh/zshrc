# ~/.zshrc: executed by zsh(1) for interactive shells.
# Environment and PATH live in ~/.zprofile; this file only shapes the interactive session.

# History is shared across sessions and skips duplicate and space-prefixed commands.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt append_history share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks
setopt interactive_comments no_beep

# Make `less` more useful for non-text files when lesspipe is installed.
[[ -x /usr/bin/lesspipe ]] && eval "$(SHELL=/bin/sh lesspipe)"

# Base aliases are defined here once; personal shortcuts stay in ~/.zsh_aliases.
if [[ -x /usr/bin/dircolors ]]; then
    if [[ -r ~/.dircolors ]]; then
        eval "$(dircolors -b ~/.dircolors)"
    else
        eval "$(dircolors -b)"
    fi
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
fi

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Send a desktop notification after a long-running command.
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(fc -ln -1 | sed -e '\''s/[;&|]\s*alert$//'\'')"'

[[ -r ~/.zsh_aliases ]] && source ~/.zsh_aliases

# Completion: menu selection, case-insensitive matching, colors from LS_COLORS.
fpath=(/home/linuxbrew/.linuxbrew/share/zsh/site-functions(N-/) $fpath)
zmodload zsh/complist
autoload -Uz compinit
mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-$ZSH_VERSION"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Vi line editing. Enter always runs the command; Alt-Enter inserts a newline.
bindkey -v
KEYTIMEOUT=1
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^H' backward-delete-char
bindkey -M viins '^W' backward-kill-word
bindkey -M viins '^U' backward-kill-line
bindkey -M viins '^R' history-incremental-search-backward
bindkey -M viins '^[^M' self-insert-unmeta
bindkey -M vicmd '/' history-incremental-search-backward

# Up and Down search history for commands starting with what is already typed.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
for keymap in viins vicmd; do
    bindkey -M $keymap '^[[A' up-line-or-beginning-search
    bindkey -M $keymap '^[OA' up-line-or-beginning-search
    bindkey -M $keymap '^[[B' down-line-or-beginning-search
    bindkey -M $keymap '^[OB' down-line-or-beginning-search
done
unset keymap

# Vim-like cursor: block in Normal mode, beam in Insert mode.
# zle-line-init also keeps Debian's keypad mode so terminfo key bindings stay valid.
zsh_vi_cursor() {
    case $KEYMAP in
        vicmd) printf '\e[2 q' ;;
        *) printf '\e[5 q' ;;
    esac
}
zle-line-init() {
    (( ${+terminfo[smkx]} )) && printf '%s' "${terminfo[smkx]}"
    zsh_vi_cursor
}
zle-keymap-select() { zsh_vi_cursor }
zle -N zle-line-init
zle -N zle-keymap-select

# Version managers, when installed.
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"

export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# Zoxide replaces repeated `cd` navigation, when installed.
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# Starship owns the prompt and shows the vi mode through its character module.
(( $+commands[starship] )) && eval "$(starship init zsh)"

# Starship's palette is fixed per config file, so keep a Latte copy of the
# Mocha config and point STARSHIP_CONFIG at it while WezTerm reports light.
starship_theme() {
    local base="${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml"
    local light="${XDG_CACHE_HOME:-$HOME/.cache}/starship/latte.toml"
    local appearance

    [[ -r $WEZTERM_APPEARANCE_FILE && -r $base ]] || return
    appearance=$(<$WEZTERM_APPEARANCE_FILE)

    if [[ $appearance == light* ]]; then
        if [[ ! -r $light || $base -nt $light ]]; then
            mkdir -p "${light:h}"
            sed "s/^palette = 'catppuccin_mocha'/palette = 'catppuccin_latte'/" "$base" >| "$light"
        fi
        export STARSHIP_CONFIG=$light
    elif [[ $STARSHIP_CONFIG == $light ]]; then
        unset STARSHIP_CONFIG
    fi
}
autoload -Uz add-zsh-hook
(( $+commands[starship] )) && add-zsh-hook precmd starship_theme

# Claude Code's auto theme asks the terminal for its background color and falls
# back to COLORFGBG when nothing answers, as can happen under WSL. Background
# 15 reads as light, 0 as dark.
terminal_colorfgbg() {
    [[ -r $WEZTERM_APPEARANCE_FILE ]] || return

    if [[ $(<$WEZTERM_APPEARANCE_FILE) == light* ]]; then
        export COLORFGBG='0;15'
    else
        export COLORFGBG='15;0'
    fi
}
add-zsh-hook precmd terminal_colorfgbg

# WezTerm has no key cheat sheet of its own, so render the one installed next to
# wezterm.lua: two bindings per row, actions in the default color and keys in
# bold blue, so the eye can tell them apart without reading.
wezkeys() {
    local sheet="${WEZTERM_APPEARANCE_FILE:h}/keys.txt"

    [[ -n $WEZTERM_APPEARANCE_FILE && -r $sheet ]] || return
    awk '
        BEGIN { group = "\033[1;35m"; key = "\033[1;34m"; off = "\033[0m" }
        function end_row() { if (n % 2) printf "\n"; n = 0 }
        /^#/ || /^[[:space:]]*$/ { next }
        /^\[/ { end_row(); gsub(/\[|\]/, ""); label = $0; next }
        {
            split($0, part, / = /)
            if (n % 2 == 0) { printf "%s%-8s%s", group, label, off; label = "" }
            printf "%-18s%s%-22s%s", part[1], key, part[2], off
            if (++n % 2 == 0) printf "\n"
        }
        END { end_row() }
    ' "$sheet"
}

# Print it when the first shell of a tab, window, or split starts. Nested
# shells skip it; run `wezkeys` to see it again.
[[ $TERM_PROGRAM == WezTerm && $SHLVL -eq 1 ]] && wezkeys

# Plugins are cloned by the installer. Syntax highlighting must load last.
zsh_plugins="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"
[[ -r "$zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] &&
    source "$zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" &&
    bindkey -M viins '^F' autosuggest-accept
[[ -r "$zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] &&
    source "$zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
unset zsh_plugins
